
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear empleado | AutoPartes Pro</title>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: #101827;
      color: white;
      font-family: Arial, sans-serif;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 25px;
    }

    .caja {
      background: #1c293b;
      width: 100%;
      max-width: 480px;
      padding: 35px;
      border-radius: 18px;
    }

    h1 {
      color: #ff8c00;
      margin-top: 0;
    }

    p {
      color: #c2ccda;
      line-height: 1.6;
    }

    label {
      display: block;
      margin-top: 18px;
      margin-bottom: 8px;
      font-weight: bold;
      font-size: 14px;
    }

    input, select {
      width: 100%;
      padding: 13px;
      border: 1px solid #526078;
      border-radius: 8px;
      background: white;
      color: #17243a;
      font-size: 15px;
    }

    button {
      width: 100%;
      margin-top: 25px;
      background: #ff8c00;
      color: #101827;
      border: none;
      padding: 15px;
      border-radius: 8px;
      font-weight: bold;
      font-size: 15px;
      cursor: pointer;
    }

    button:hover { background: #ffa333; }

    .volver {
      display: block;
      margin-top: 20px;
      text-align: center;
      color: #ffb45c;
    }

    .aviso {
      background: #293a52;
      padding: 14px;
      border-radius: 8px;
      font-size: 13px;
    }
  </style>
</head>

<body>
  <main class="caja">
    <h1>Alta de empleado</h1>

    <p>
      Registro de empleados de AutoPartes Pro.
    </p>

    <p class="aviso">
      🔒 Solo los administradores autorizados
      podrán crear cuentas.
      Esta pantalla es un prototipo visual.
    </p>

    <form id="formEmpleado">
      <label for="nombre">Nombre completo</label>
      <input id="nombre" type="text"
             placeholder="Nombre del empleado"
             required>

      <label for="correo">Correo institucional</label>
      <input id="correo" type="email"
             placeholder="correo@empresa.com"
             required>

      <label for="area">Área de trabajo</label>
      <select id="area" required>
        <option value="">Selecciona un área</option>
        <option>Ventas</option>
        <option>Almacén</option>
        <option>Inventario</option>
        <option>Entregas</option>
        <option>Administración</option>
      </select>

      <label for="rol">Rol autorizado</label>
      <select id="rol" required>
        <option value="">Selecciona un rol</option>
        <option value="usuario">Empleado</option>
        <option value="administrador">Administrador</option>
      </select>

      <button type="submit">Crear cuenta</button>
    </form>

    <p id="mensaje" role="status"></p>

    <a class="volver" href="usuarios.html">
      ← Volver a empleados
    </a>
  </main>

  <script>
    document.getElementById("formEmpleado")
      .addEventListener("submit", function(evento) {
        evento.preventDefault();

        document.getElementById("mensaje")
          .textContent =
          "Formulario de demostración. " +
          "Para crear una cuenta real se necesita " +
          "un servicio de autenticación con permisos seguros.";
      });
  </script>
</body>
</html>
